APP_NAME=MyscoolApp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ton-domaine.com

# ============================================================
# BASE DE DONNÉES — à remplir dans Laravel Cloud
# ============================================================
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ============================================================
# SESSION / CACHE / QUEUE
# En production, on utilise la base de données (ou Redis)
# ============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false

CACHE_STORE=database
CACHE_PREFIX=myscoolapp

QUEUE_CONNECTION=database

# ============================================================
# LOGS
# ============================================================
LOG_CHANNEL=stack
LOG_LEVEL=error

# ============================================================
# MAIL — Gmail SMTP en production
# MAIL_PASSWORD = mot de passe d'application Gmail (pas le mot de passe du compte)
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# GOOGLE OAUTH — credentials à régénérer (les anciens ont fuité)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ton-domaine.com/auth/google/callback

# ============================================================
# STORAGE S3 (Laravel Cloud) — optionnel au départ
# ============================================================
FILESYSTEM_DISK=local
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"